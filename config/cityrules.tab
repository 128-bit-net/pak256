# 街の成長の決まり（この物が無いと本体は起動しない）
#
# pak128 のものを写さず、街が建てる物の形から新しく書いた短い版。
# 道路に沿って家を建て、道路を延ばし、枝道を出す、までを最小限で行う。
# 家の種類（住宅・商業・工業）の選び方は、建物の側（#8）の属性で決まる。
# ここでは置く場所の形だけを決める。
# 実際の街の形（区画の大きさ・道の混み方）は、建物（#8）と AMI の道路が入ってから
# ゲームで見て直す。

# 街どうしの最低の間隔（タイル）。街の中心から測る。
# 1 タイルが 256px になっても街の広さの感覚は変えないので、pak128 の 32 にする。
minimum_city_distance = 32

# 新築ではなく建て替えを選ぶ割合（％）。大きいほど外へ広がらない。
renovation_percentage = 12

# 道に沿った建物の密度（％）がこれより低いと、その道の先へは広げない。
minimum_building_density = 33
# 本家の 125.0.1 が綴りの違う古い名前しか読まないおそれがあるので、同じ値を両方書く
# （OTRP は新しい名前を優先する）。
minimum_building_desity = 33

# 建物の種類どうしの引き合い。正は近くに建てたがり、負は避ける。
res_start_score = 0
res_near_ind = -8
res_near_com = 0
res_near_res = 8

com_start_score = -10
com_near_ind = 1
com_near_com = 8
com_near_res = 1

ind_start_score = 0
ind_near_ind = 8
ind_near_com = 0
ind_near_res = -8

# ---- 書き方 ----
# 1 つの決まりは、1 辺が 3・5・7 の正方形の並び。行どうしを空白で区切り、全行の
# 長さをそろえる。中央が、今調べている空き地。
# 本体は、決まりを 90 度ずつ回した 4 通りを試す（左右反転は試さない）。
# 記号: n 空き地  s 道路  S 道路でない  h 家  H 家でない  t 停留所  T 停留所でない
#       . なんでもよい
# .chance は試す頻度。本体は 1/(8+chance) の確率で規則を試すので、小さい（負の）ほど
# 頻繁に試される（-2 で 1/6、-4 で 1/4）。

#### 家 ####

# 道路に面した 1 軒（道路が下に 3 タイル並ぶ）
house_1 = ... .n. sss
house_1.chance = -2

# 道路の曲がり角に建つ
house_2 = ... .ns .ss
house_2.chance = -2

# 道の行き止まりに建つ（左右と奥は道でなく、手前に道が 2 タイル続く）。
# 手前が 1 タイルの短い道だと、その先に建って道を延ばせなくするので、2 タイルにしてある。
house_3 = ..... ..S.. .SnS. ..s.. ..s..
house_3.chance = -2

# 並ぶ家のあいだを埋める（左右が家、下も家）
house_4 = ... hnh .h.
house_4.chance = -2

# 停留所のすぐ近くに建つ
house_5 = ... .n. sts
house_5.chance = -2

#### 道路 ####

# 道の延長（短い道用）。道の端から 1 本、家のない向きへまっすぐ延ばす（周りは道にしない）。
# 役場が 1 タイルなので、街は道 1 タイルから始まる。後ろに道が 1 タイルあれば延ばせるようにして、
# そこから伸ばす。
road_1 = ..S.. .SSS. .snHH .SSS. ..S..
road_1.chance = -4

# 道の延長（長い道用）。後ろに道が 2 タイル続くとき、両脇に道を作らずにもう 1 タイル延ばす。
road_2 = ..S.. ..S.. ssnHH ..S.. ..S..
road_2.chance = -4

# 枝道。まっすぐな道（下）から、左右 2 タイルは道のない所に 1 本出す。
road_3 = ..H.. .SSS. SSnSS sssss .....
road_3.chance = -4

# 1 タイルのすき間をつなぐ（左右が道で、上下は道でない）。
road_4 = .S. sns .S.
road_4.chance = -2
