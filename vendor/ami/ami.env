# 同梱する AMI の 256 版（docs/layout.md の「AMI の 256 版を同梱する」）。tools/fetch_ami.py が読む。
# AMI が 256 版の zip を Release に上げたら、3 つを書く。上がるまでは空のままにし、
# 手元で組んだ AMI の pak を環境変数 AMI_DIST で渡す。
# 256 版は AMI #266 の後に、プレリリース ami-256-alpha.1 の ami-256-alpha.1.zip（256 版の pak だけ）として出る予定。
# AMI_VERSION: AMI の Release のタグ（例 ami-256-alpha.1）
# AMI_ZIP_URL: 128na/simutrans-addon-dev の Release の zip の URL
#   （例 https://github.com/128na/simutrans-addon-dev/releases/download/ami-256-alpha.1/ami-256-alpha.1.zip）
# AMI_ZIP_SHA256: その zip の SHA-256（sha256sum で取る）
AMI_VERSION=ami-256-alpha.1
AMI_ZIP_URL=https://github.com/128na/simutrans-addon-dev/releases/download/ami-256-alpha.1/ami-256-alpha.1.zip
AMI_ZIP_SHA256=5f8439ba152082480f8be643a432a873b5c86dd0e49f61b56c9bfd50faff8413
