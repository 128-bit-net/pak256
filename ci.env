# CI（.github/workflows/ci.yml）が使う道具の版。workflow には版を直に書かず、ここから読む。
# MAKEOBJ_TAG: 本家（simutrans/simutrans）のリリースのタグ。その Linux 版 makeobj を使う（取り方は tools/ci/setup_makeobj.sh）。
#   手元の Windows 版は 60.12（本家 125.0 の Linux 版は 60.10）。
# PYTHON_VERSION: tools/ の Python の道具を動かす版。
MAKEOBJ_TAG=125.0
PYTHON_VERSION=3.12
